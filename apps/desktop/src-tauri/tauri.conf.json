{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PinchDrop",
  "version": "0.1.0",
  "identifier": "com.pinchdrop.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PinchDrop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "copyright": "Copyright © 2026 PinchDrop Authors",
    "shortDescription": "Move things with your hands",
    "longDescription": "PinchDrop is a Windows desktop application that lets you move and organise files, links, and text between your PC and phone using webcam hand gestures.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["en-US"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ahmadmdsajid129/pinchdrop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IFIwV1NBTVAxRVBLRVkKUlVUMUJBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE="
    }
  }
}

